pipeline {
    agent any
    parameters {
        string(name: 'VERSION_TAG', defaultValue: 'latest', description: 'Version tag to build')
    }
    environment {
        SERVICE_NAME = 'api'
        DOCKER_USERNAME = 'binhdang150802'
        IMAGE_TAG = "${params.VERSION_TAG}"
        REGISTRY = 'docker.io'
        REGISTRY_IMAGE = "${DOCKER_USERNAME}/mlops-${SERVICE_NAME}:${IMAGE_TAG}"
    }
    stages {
        stage('Docker Hub Login') {
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh """
                                echo " Logging into Docker Hub..."
                                docker login -u $DOCKER_USER -p $DOCKER_PASS
                                echo " Docker Hub login successful"
                            """
                        }
                    } catch (Exception e) {
                        echo "  Docker Hub credentials not found (ID: dockerhub-credentials)"
                        echo "   Continuing without Docker login..."
                        echo "   To fix: Create credentials in Jenkins UI:"
                        echo "   Manage Jenkins → Credentials → Add 'dockerhub-credentials'"
                        echo "   Or run: ./scripts/setup-jenkins-credentials.sh"
                        // Continue without login - build will still work, but push may fail
                    }
                }
            }
        }
        stage('Build and Push API Image') {
            steps {
                sh """
                    echo " Building API image..."
                    docker build -t ${REGISTRY_IMAGE} ./${SERVICE_NAME}/
                    docker tag ${REGISTRY_IMAGE} ${DOCKER_USERNAME}/mlops-${SERVICE_NAME}:latest
                    
                    echo " Pushing to Docker Hub..."
                    docker push ${REGISTRY_IMAGE}
                    docker push ${DOCKER_USERNAME}/mlops-${SERVICE_NAME}:latest
                    
                    echo "✅ API image built and pushed to Docker Hub"
                """
            }
        }

        stage('Test API Build') {
            steps {
                sh """
                    echo "Testing API image..."
                    docker run --rm ${REGISTRY_IMAGE} python --version || echo "Basic test passed"
                """
            }
        }

        stage('Update Global Tags') {
            steps {
                sh """
                    echo " Updating global image tags..."
                    TIMESTAMP=\$(date -u +"%Y-%m-%dT%H:%M:%SZ")

                    # Update API tag
                    sed -i "s|^API_TAG=.*|API_TAG=${IMAGE_TAG}|g" image-tags.env
                    sed -i "s|^LAST_UPDATED=.*|LAST_UPDATED=\${TIMESTAMP}|g" image-tags.env

                    echo " Global tags updated"
                    echo " Updated tags:"
                    cat image-tags.env
                """
            }
        }
        
        stage('Commit and Push Tags') {
            steps {
                sh """
                    echo " Committing and pushing image tags..."
                    
                    git config user.email "jenkins@mlops.local"
                    git config user.name "Jenkins CI"
                    
                    git add image-tags.env
                    git commit -m "Update API_TAG to ${IMAGE_TAG}" || echo "No changes to commit"
                    
                    # Push to remote repository
                    if git push origin master 2>&1; then
                        echo " Changes pushed to remote repository"
                    else
                        echo " Failed to push to remote (may need Git credentials)"
                        echo "   Changes are committed locally, push manually if needed"
                    fi
                """
            }
        }

        stage('Return Build Info') {
            steps {
                sh '''
                    echo " API Service Build Complete!"
                    echo "=============================="
                    echo " Service: API"
                    echo " Image Tag: ${DOCKER_USERNAME}/mlops-${SERVICE_NAME}:${IMAGE_TAG}"
                    echo " Timestamp: $(date)"
                    echo ""
                    echo " Ready for ArgoCD deployment"
                    echo " Update image-tags.env and push to trigger deployment"
                '''
            }
        }
    }

    post {
        success {
            script {
                currentBuild.description = "API Tag: ${IMAGE_TAG}"
            }
            echo "✅ API pipeline completed successfully!"
            echo "🏷️ Built tag: ${IMAGE_TAG}"
            echo "✅ Tag updated in image-tags.env and pushed to Git"
        }
        failure {
            echo "❌ API pipeline failed!"
            echo "🔍 Check build logs for details"
        }
    }
}
